POSTGRES_PASSWORD=replace-with-strong-db-password

PHX_HOST=weather.example.com
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret
TOKEN_SIGNING_SECRET=replace-with-random-token-signing-secret
POOL_SIZE=10
DAILYLOG_IN_LOCAL=false # setting this to true will load the dailylog from the local midnight and will display data in local installation timezone
DAILYLOG_WIND_IN_KMH=false

STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-access-key
STORAGE_BUCKET=voria2-media
STORAGE_REGION=auto
STORAGE_PUBLIC_ENDPOINT=https://media.example.com
MAX_WEBCAM_UPLOAD_MB=5
ADMIN_EMAIL=admin@localhost
ADMIN_NAME=Admin
ADMIN_PASSWORD=replace-with-initial-admin-password
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_SECONDS=2
